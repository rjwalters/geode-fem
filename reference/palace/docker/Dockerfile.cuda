# Palace Electromagnetic Solver — CUDA (GPU) Docker build
#
# GPU variant of ./Dockerfile for the Palace-on-GPU head-to-head (issue #519,
# epic #476). Differs from the CPU recipe in four load-bearing ways:
#   1. nvidia/cuda *-devel-rockylinux9 base image (brings nvcc + CUDA libs).
#   2. -DPALACE_WITH_CUDA=ON
#   3. -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCH}  (default 89 = L40S / Ada, the
#      g6e GPU; #519 actually ran with --build-arg CUDA_ARCH=80 on an A100)
#   4. -DPALACE_WITH_MAGMA=ON          (Palace's GPU dense-LA path)
# libCEED's /gpu/cuda/* backends are built automatically once CUDA is ON; the
# backend is selected at RUN time via the Palace config ("Device": "GPU") and/or
# the CEED_BACKEND env var — capture whichever string the run log prints into
# the fixture provenance.
#
# Single-stage on purpose: the -devel image already carries the CUDA runtime +
# math libs (cublas/cusparse) that Palace + MAGMA link, so we avoid a hand-picked
# runtime stage silently dropping a needed .so. Reproducibility > image size for
# a one-off oracle build.
#
# Build (on the GPU box; set CUDA_ARCH to the GPU's sm, e.g. 80 = A100,
# 89 = L40S, 90 = H100):
#   docker build --build-arg CUDA_ARCH=80 -t palace:cuda -f Dockerfile.cuda .
# Verified 2026-10-07 (#519): builds clean in 856 s on a 30-vCPU host after
# the three build fixes below (mpich LTO flags, CUDAHOSTCXX, libcuda stub).
# Run (GPU exposed via nvidia-container-toolkit). `--gpus all` is required
# even for "Device": "CPU" runs — the binary links libcuda.so.1:
#   docker run --rm --gpus all -v $(pwd):/work palace:cuda -np 1 /work/config.json
#
# CUDA_TAG can be overridden if 12.6.3 is unavailable for rockylinux9:
#   docker build --build-arg CUDA_TAG=12.4.1-devel-rockylinux9 ...

ARG CUDA_TAG=12.6.3-devel-rockylinux9
FROM nvidia/cuda:${CUDA_TAG}

# sm_89 = L40S (Ada). Override at build time for a different GPU (e.g. 90 = H100).
ARG CUDA_ARCH=89
ARG MARCH=native
ENV OPT_FLAGS="-O3 -ffp-contract=fast -funroll-loops"

# NOTE: no blanket `dnf update -y` here — it can pull a newer CUDA minor from the
# NVIDIA repo and desync the toolkit from the pinned base tag. Install only what
# the Palace superbuild needs.
RUN dnf install -y dnf-plugins-core && dnf config-manager --enable crb && \
    dnf install -y epel-release && \
    dnf groupinstall -y "Development Tools" && \
    dnf install -y \
        curl-minimal \
        gcc-gfortran \
        git \
        libunwind-devel \
        openblas-devel \
        pkg-config \
        python3 \
        time \
        wget \
        which \
        zlib \
        mpich-devel && \
    dnf clean all

# Rocky 9's mpich-devel (4.1.1) bakes the distro RPM optflags into its
# compiler wrappers: `mpicxx -show` emits `-O2 -flto=auto -ffat-lto-objects
# ...`. CMake's FindMPI propagates those to every superbuild target, so the
# whole build is LTO'd — harmless on the CPU image, but with CUDA the LTO link
# of nvcc-produced objects fails (SUNDIALS libsundials_nveccuda.so:
# "Error: symbol `fatbinData' is already defined", lto-wrapper failed;
# observed on the #519 build, 2026-10-07). Strip ONLY the two LTO flags from
# the wrappers (and the pkg-config file); every other wrapper flag is kept.
RUN for f in /usr/lib64/mpich/bin/mpicc /usr/lib64/mpich/bin/mpicxx \
             /usr/lib64/mpich/bin/mpif77 /usr/lib64/mpich/bin/mpif90 \
             /usr/lib64/mpich/bin/mpifort $(find /usr/lib64 -name 'mpich*.pc'); do \
      [ -f "$f" ] && sed -i -e 's/-flto=auto//g' -e 's/-ffat-lto-objects//g' "$f"; \
    done; \
    /usr/lib64/mpich/bin/mpicxx -show | tee /opt/mpicxx-show.txt; \
    ! grep -q -- '-flto' /opt/mpicxx-show.txt

ARG CMAKE_VERSION=3.31.0
RUN wget -q https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-$(uname -m).sh && \
    /bin/bash cmake-${CMAKE_VERSION}-*.sh --skip-license --prefix=/usr && \
    rm -rf cmake-*

ENV LD_LIBRARY_PATH="/usr/lib64/mpich/lib:/usr/local/cuda/lib64"
ENV PATH="/usr/lib64/mpich/bin:/usr/local/cuda/bin:${PATH}"
# Palace's superbuild forwards CMAKE_CUDA_COMPILER/FLAGS to the inner `palace`
# project (cmake/ExternalPalace.cmake) but NOT CMAKE_CUDA_HOST_COMPILER, and
# BLT (pulled in via umpire -> camp) aborts the inner configure with "CUDA
# language enabled prior to setting CMAKE_CUDA_HOST_COMPILER" (observed on
# the #519 build at fba6a5b, 2026-10-07). CMake seeds CMAKE_CUDA_HOST_COMPILER
# from CUDAHOSTCXX at CUDA enablement, so set it to the same g++ every other
# sub-build already uses.
ENV CUDAHOSTCXX=/usr/bin/g++

# PALACE_REF pins the Palace source. Default = fba6a5b, the SAME changeset as
# the committed CPU baseline (reference/fixtures/transmon_palace/results_p1/
# palace_run_v22.log: "Git changeset ID: fba6a5b"), so a CPU-vs-GPU eigenvalue
# comparison isolates the device, not a Palace version drift (#519).
ARG PALACE_REF=fba6a5b9d17ef09db2907e9c4c6f92d123d131c0
WORKDIR /opt
RUN git clone https://github.com/awslabs/palace.git palace-src && \
    cd palace-src && git checkout --detach ${PALACE_REF} && git log -1 --format='%H %cI %s'

WORKDIR /opt/palace-build
# `docker build` has no GPU driver, so libcuda.so.1 (which libCEED's CUDA
# backends link) is absent and Palace's configure-time libCEED test program
# fails to link ("libCEED could not be found, be sure to set LIBCEED_DIR";
# observed on the #519 build — the identical superbuild succeeds under
# `docker run --gpus all`, where the driver injects libcuda.so.1). Resolve it
# against the CUDA toolkit's link stub for THIS build step only; the stub dir
# is NOT on the runtime LD_LIBRARY_PATH, so the real driver library injected
# by nvidia-container-toolkit is what runs.
RUN ln -sf /usr/local/cuda/lib64/stubs/libcuda.so /usr/local/cuda/lib64/stubs/libcuda.so.1 && \
    export LD_LIBRARY_PATH="/usr/local/cuda/lib64/stubs:${LD_LIBRARY_PATH}" && \
    export LIBRARY_PATH="/usr/local/cuda/lib64/stubs:${LIBRARY_PATH}" && \
    cmake /opt/palace-src \
    -DCMAKE_INSTALL_PREFIX=/opt/palace \
    -DCMAKE_CXX_COMPILER=g++ \
    -DCMAKE_CXX_FLAGS="${OPT_FLAGS}" \
    -DCMAKE_C_COMPILER=gcc \
    -DCMAKE_C_FLAGS="${OPT_FLAGS}" \
    -DCMAKE_Fortran_COMPILER=gfortran \
    -DCMAKE_Fortran_FLAGS="${OPT_FLAGS}" \
    -DCMAKE_CUDA_COMPILER=/usr/local/cuda/bin/nvcc \
    -DCMAKE_CUDA_ARCHITECTURES=${CUDA_ARCH} \
    -DBUILD_SHARED_LIBS=ON \
    -DPALACE_WITH_64BIT_INT=OFF \
    -DPALACE_WITH_OPENMP=ON \
    -DPALACE_WITH_CUDA=ON \
    -DPALACE_WITH_MAGMA=ON \
    -DPALACE_WITH_HIP=OFF \
    -DPALACE_WITH_SUPERLU=ON \
    -DPALACE_WITH_STRUMPACK=ON \
    -DPALACE_WITH_MUMPS=ON \
    -DPALACE_WITH_SLEPC=ON \
    -DPALACE_WITH_ARPACK=ON \
    -DPALACE_WITH_LIBXSMM=OFF \
    -DPALACE_WITH_GSLIB=ON && \
    cmake -LA -N /opt/palace-build \
      | grep -E '^(PALACE_|CMAKE_CUDA|CMAKE_(C|CXX|Fortran)_(COMPILER|FLAGS)|CMAKE_BUILD_TYPE|BUILD_SHARED_LIBS)' \
      > /opt/palace-build-flags.txt && \
    make -j$(nproc)

ENV LD_LIBRARY_PATH="/opt/palace/lib:/opt/palace/lib64:/usr/lib64/mpich/lib:/usr/local/cuda/lib64"
ENV PATH="/opt/palace/bin:/usr/lib64/mpich/bin:/usr/local/cuda/bin:${PATH}"

WORKDIR /work
ENTRYPOINT ["palace"]
