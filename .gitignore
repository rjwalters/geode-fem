# Committed benchmark evidence log (recovered at-scale run; see issue #556)
!benchmarks/transmon_bench_cpu/geode_runs_1p16M_2026-07-15.log
# Committed Palace run evidence log (tracked before *.log rule; negated for consistency)
!reference/fixtures/transmon_palace/results_p1/palace_run_v22.log
# #519 Palace-GPU head-to-head run evidence (raw per-run logs + provenance)
!benchmarks/transmon_bench_gpu/runs/**/*.log
# #520 GPU driven-scaling sweep run evidence (per-leg logs, Palace logs, TF32 evidence)
!benchmarks/gpu_driven_scaling/runs/**/*.log
# #927 like-for-like CPU re-timing raw mode logs (build.log stays ignored)
!benchmarks/transmon_bench_cpu/runs/**/raw/*.log
# #1078 Palace coupling cross-check run logs (cited by provenance.txt)
!reference/fixtures/transmon_palace/results_coupling_1078/*/palace_run.log
# #1079 Palace loop-inductance run logs (cited by provenance.txt)
!reference/fixtures/transmon_palace/results_loop_1079/*/palace_run.log
# #1084 curved conformal 2.4 GHz fixture: baseline / generator / re-check logs
!benchmarks/patch_antenna_conformal/logs/*.log
# #1146 Meep harness-v2 run records (cgroup memory samples, run logs; listed in SHA256SUMS)
!benchmarks/fdtd_density_baseline/meep_runs/v2/**/*.log
# #1092 DeviceLayout cross-check: Palace run logs (cited by provenance.txt) and geode solve logs
!reference/fixtures/transmon_palace/results_crosscheck_1092/*/palace_run.log
!benchmarks/transmon_devicelayout_crosscheck/logs/*.log
# #1092 part 2 re-optimization: Palace run logs, geode solve and ladder logs
!reference/fixtures/transmon_palace/results_optimize_1092/*/palace_run.log
!benchmarks/transmon_devicelayout_optimize/logs/*.log
!benchmarks/transmon_devicelayout_optimize/ladder_*/logs/*.log
# #1123 controls: Palace run logs and worker orchestration / memory logs
!reference/fixtures/transmon_palace/results_controls_1123/*/palace_run.log
!reference/fixtures/transmon_palace/results_controls_1123/logs/*.log
# #1129 controls: Palace run logs and worker orchestration / memory logs
!reference/fixtures/transmon_palace/results_controls_1129/*/palace_run.log
