!reference/fixtures/transmon_palace/results_controls_1135/*/palace_run.log
!reference/fixtures/transmon_palace/results_controls_1135/logs/*.log
# #1579 Design A min-max run: the run's own stdout (cost probe and the true
# per-iteration worst case, which results.toml's [history] does not carry)
!benchmarks/tcda_design/run.log
# #1145 T7: adaptive refinement on the final design, Palace run log and worker orchestration / memory logs
!reference/fixtures/transmon_palace/results_controls_1145/*/palace_run.log
!reference/fixtures/transmon_palace/results_controls_1145/logs/*.log
