# <<< loom-managed <<<

# Local credentials / secrets — never commit
.env
.env.*
!.env.example
*.local.md
.claude/settings.local.json
/.voice/

# Repo Skills machine-local install metadata (absolute source path + timestamp)
.claude/skills/repo/.install-local.json

# Anvil paper-vision per-page render intermediates (regenerable at 200 DPI from main.pdf)
papers/**/*.vision/pages/
**/*.vision/pages/
**/*.vision/slides/

# Vendored Anvil skill install — reinstall with anvil's install.sh.
# Untracked deliberately: a copy-installed tool tree does not belong in a
# public repo, and this one carried third-party content (2AMLogic/2am#94).
.anvil/
.squad/
.claude/skills/squad/.install-local.json

# #1084: flat companions of bent patch fixtures are regenerated, not committed
crates/geode-core/tests/fixtures/*.flat.msh

# #1410: cargo ignores a dependency's own Cargo.lock (the root Cargo.lock is
# authoritative) but rewrites one inside vendored crates whenever it resolves
# there, which dirtied the checkout. Never track them.
vendor/*/Cargo.lock

# Repo Skills Codex-side machine-local install metadata (never committed)
.agents/skills/repo/.install-local.json

