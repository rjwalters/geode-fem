+    eprintln!("diag945 real 133k AMS-only inner-CG iterations = {iters}");
+    for (i, m) in modes.iter().enumerate() {
+        eprintln!("diag945 mode[{i}] = {:.12} GHz", m.frequency_ghz());
+    }
+}
