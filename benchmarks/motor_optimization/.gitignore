# Fresh meshes made by the validator's policy path (rebuilt by run_all.sh;
# the SHA-256 of each is in the run record).
runs/*.meshes/*.msh
# Harness (#1195): fresh meshes and per-run plans written by the evaluator
# (each SHA-256 is in the run trace), and the locked Python environment.
**/meshes/**/*.msh
**/meshes/**/plan_*.json
harness/.venv/
